// Copy this file to `Secrets.xcconfig` (same directory) and fill in your own key.
// `Secrets.xcconfig` is git-ignored — never commit your real API key.
//
// Get a key at https://console.cloud.google.com/ — enable "Places API (New)".

GOOGLE_PLACES_API_KEY = YOUR_API_KEY_HERE

// Accounts/sync backend. Create a free project at https://supabase.com, then find these
// under Project Settings -> API. Run supabase/schema.sql in the SQL editor once, and turn
// on the Apple provider under Authentication -> Providers before Sign in with Apple works.
SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY_HERE
