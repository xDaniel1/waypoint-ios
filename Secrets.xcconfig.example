// Copy this file to `Secrets.xcconfig` (same directory) and fill in your own key.
// `Secrets.xcconfig` is git-ignored — never commit your real API key.
//
// Get a key at https://console.cloud.google.com/ — enable "Places API (New)".

GOOGLE_PLACES_API_KEY = YOUR_API_KEY_HERE

// Free from https://register.developer.obanyc.com — live bus arrivals.
// Without it, bus rides fall back to scheduled times.
MTA_BUS_TIME_API_KEY = YOUR_MTA_BUS_TIME_KEY_HERE
