// Copy this file to `Secrets.xcconfig` (same directory) and fill in your own key.
// `Secrets.xcconfig` is git-ignored — never commit your real API key.
//
// Get a key at https://console.cloud.google.com/ — enable "Places API (New)".

GOOGLE_PLACES_API_KEY = YOUR_API_KEY_HERE

// Accounts/sync backend. Create a free project at https://supabase.com, then find these
// under Project Settings -> API. Run supabase/schema.sql in the SQL editor once, and turn
// on the Apple provider under Authentication -> Providers before Sign in with Apple works.
SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY_HERE

// Sign in with Google. Create an "iOS" OAuth client at
// https://console.cloud.google.com/apis/credentials (bundle ID: com.danielguzman.waypoint), then
// add that same client ID under Supabase's Authentication -> Providers -> Google -> Client IDs.
// GOOGLE_IOS_URL_SCHEME is the client ID reversed, e.g. a client ID of
// 123-abc.apps.googleusercontent.com becomes com.googleusercontent.apps.123-abc — Google shows
// you this exact value on the same credentials page ("iOS URL scheme").
GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
